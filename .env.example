# Origin that serves the PHP form endpoints (enquiry, contact, newsletter).
# Leave unset in production: the endpoints are served from the site itself.
# The Vite dev server cannot execute PHP, so in development point this at the
# Laragon host that serves public/api, e.g.
#   VITE_API_BASE_URL=http://cost-low-global.test/public
# See src/utils/api.js.
VITE_API_BASE_URL=
